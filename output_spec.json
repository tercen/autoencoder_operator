{
  "outputSpecs": [{
    "kind": "OperatorJoinSpec",
    "description": "Autoencoder output with encoded dimensions and cluster assignments",
    "joinOperators": [{
      "kind": "JoinOperator",
      "joinType": "left",
      "leftPair": {
        "kind": "ColumnPair",
        "lColumns": ["Observation"],
        "rColumns": ["Observation"]
      },
      "rightRelation": {
        "kind": "TableRelation",
        "description": "Encoded dimensions (dynamic based on bottleneck size) plus clusters",
        "attributes": [
          {"kind": "Attribute", "name": "clusters", "type": "int32"}
        ]
      }
    }]
  }]
}
